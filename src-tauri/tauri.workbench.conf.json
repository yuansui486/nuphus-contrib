{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuphus Workbench",
  "mainBinaryName": "nuphus-workbench",
  "identifier": "io.github.yuansui486.nuphusworkbench",
  "version": "0.1.0",
  "app": {
    "security": {
      "assetProtocol": {
        "scope": { "allow": ["$APPDATA/**", "$APPLOCALDATA/**", "$HOME/.nuphus-workbench/**", "$TEMP/**"] }
      }
    }
  },
  "build": {
    "beforeDevCommand": "node scripts/prepare-workbench-mcp.mjs --debug && npm run dev:workbench",
    "beforeBuildCommand": "node scripts/prepare-workbench-mcp.mjs && npm run build:workbench",
    "devUrl": "http://localhost:5176",
    "frontendDist": "../frontend/dist-workbench"
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/nuphus-workbench-mcp"],
    "windows": { "nsis": { "installerHooks": "installer/workbench-hooks.nsh" } },
    "macOS": { "minimumSystemVersion": "15.0" }
  }
}
